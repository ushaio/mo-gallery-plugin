{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ushaio/mo-gallery-plugin/master/schema/index.schema.json",
  "title": "MO Gallery Plugin Marketplace Index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "updatedAt", "plugins"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "updatedAt": { "type": "string", "format": "date-time" },
    "plugins": {
      "type": "array",
      "items": { "$ref": "#/$defs/plugin" }
    }
  },
  "$defs": {
    "categorySlug": {
      "description": "分类栏标识。取值必须是 categories.json 里声明过的 id —— 加一栏请改那份文件，不要在这里加枚举：客户端的栏名与顺序都从 categories.json 读，本文件只约束写法。",
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 32
    },
    "contribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "apiVersion"],
      "properties": {
        "domain": { "type": "string", "minLength": 1 },
        "apiVersion": { "type": "string", "minLength": 1 },
        "capabilities": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "sha256", "size"],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://github\\.com/ushaio/mo-gallery-plugin/releases/download/[^/]+/[^/]+$"
        },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size": { "type": "integer", "minimum": 1, "maximum": 268435456 }
      }
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "coreApiVersion", "platforms"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
        "name": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "author": { "type": "string" },
        "version": { "type": "string", "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
        "coreApiVersion": { "type": "string", "minLength": 1 },
        "category": {
          "description": "Marketplace shelves this plugin belongs to, written as slugs declared in categories.json（客户端把该文件当作分类 API 拉取：栏名与顺序都在那里）。字符串与字符串数组都收，写多个表示同时挂在多栏下；省略时客户端按能力域兜底，兜不到就落进它的「其他」栏。",
          "oneOf": [
            { "$ref": "#/$defs/categorySlug" },
            {
              "type": "array",
              "items": { "$ref": "#/$defs/categorySlug" },
              "minItems": 1,
              "uniqueItems": true
            }
          ]
        },
        "contributions": {
          "type": "array",
          "items": { "$ref": "#/$defs/contribution" }
        },
        "homepage": { "type": "string", "format": "uri" },
        "repository": { "type": "string", "format": "uri" },
        "platforms": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "windows-amd64": { "$ref": "#/$defs/artifact" },
            "darwin-amd64": { "$ref": "#/$defs/artifact" },
            "darwin-arm64": { "$ref": "#/$defs/artifact" },
            "linux-amd64": { "$ref": "#/$defs/artifact" },
            "linux-arm64": { "$ref": "#/$defs/artifact" }
          }
        }
      }
    }
  }
}
