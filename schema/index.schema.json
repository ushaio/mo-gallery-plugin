{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ushaio/mo-gallery-plugin/master/schema/index.schema.json",
  "title": "MO Gallery Plugin Marketplace Index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "updatedAt", "plugins"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "updatedAt": { "type": "string", "format": "date-time" },
    "plugins": {
      "type": "array",
      "items": { "$ref": "#/$defs/plugin" }
    }
  },
  "$defs": {
    "categorySlug": {
      "description": "分类栏标识。取值必须是 categories.json 里声明过的 id —— 加一栏请改那份文件，不要在这里加枚举：客户端的栏名与顺序都从 categories.json 读，本文件只约束写法。",
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 32
    },
    "localizedText": {
      "description": "随界面语言变化的文案。两种写法都收：直接写一个字符串（每个界面语言都用它），或写「界面语言代码 → 文案」让同一份索引跟着界面语言切换——写成映射时中英都要给，只给一种会让另一种界面直接显示成外语。客户端按界面语言取，取不到再退回另一种。",
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[a-z]{2}(?:-[A-Za-z]{2,8})*$" },
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      ]
    },
    "contribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "apiVersion"],
      "properties": {
        "domain": { "type": "string", "minLength": 1 },
        "apiVersion": { "type": "string", "minLength": 1 },
        "capabilities": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "sqliteScope": {
      "description": "permissions 的补充说明：插件会创建哪些库文件、请求多大的数据目录。它不能独立存在——没有 sqlite: 能力却写这一块，说明 manifest 自相矛盾，校验会拒绝。",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "databases": {
          "description": "插件会创建的库文件名（不是路径），必须落在它自己的数据目录里。",
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,64}\\.(sqlite|db|sqlite3)$"
          },
          "uniqueItems": true,
          "minItems": 1,
          "maxItems": 8
        },
        "quotaBytes": {
          "description": "请求的数据目录上限（1 MiB – 1 GiB，省略按宿主默认 256 MiB）；超出上限时宿主会拒绝启动或终止进程。",
          "type": "integer",
          "minimum": 1048576,
          "maximum": 1073741824
        }
      }
    },
    "permissionId": {
      "description": "插件进程需要的能力，写法 <namespace>:<subject>[:<access>]。这里的取值必须与插件包内 manifest.json 的 permissions 一致，并且只能取官方登记过的能力——未登记的能力会被宿主拒绝安装，所以这份枚举有意写死。完整语义、作用域与界面文案见 CAPABILITIES.md。",
      "type": "string",
      "enum": [
        "network:configured-endpoint",
        "sqlite:data:read",
        "sqlite:data:read-write",
        "sqlite:library:read",
        "addons:onnx"
      ]
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "sha256", "size"],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://github\\.com/ushaio/mo-gallery-plugin/releases/download/[^/]+/[^/]+$"
        },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "size": { "type": "integer", "minimum": 1, "maximum": 268435456 }
      }
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "coreApiVersion", "platforms"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
        "name": {
          "description": "插件显示名。写法见 localizedText，想跟着界面语言切换就写成「语言代码 → 名称」。",
          "$ref": "#/$defs/localizedText"
        },
        "description": {
          "description": "插件介绍，写法同 name。省略时市场页不显示介绍。",
          "$ref": "#/$defs/localizedText"
        },
        "author": { "type": "string" },
        "version": { "type": "string", "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
        "coreApiVersion": { "type": "string", "minLength": 1 },
        "category": {
          "description": "Marketplace shelves this plugin belongs to, written as slugs declared in categories.json（客户端把该文件当作分类 API 拉取：栏名与顺序都在那里）。字符串与字符串数组都收，写多个表示同时挂在多栏下；省略时客户端按能力域兜底，兜不到就落进它的「其他」栏。",
          "oneOf": [
            { "$ref": "#/$defs/categorySlug" },
            {
              "type": "array",
              "items": { "$ref": "#/$defs/categorySlug" },
              "minItems": 1,
              "uniqueItems": true
            }
          ]
        },
        "contributions": {
          "type": "array",
          "items": { "$ref": "#/$defs/contribution" }
        },
        "permissions": {
          "description": "安装前预览的插件进程能力，必须与包内 manifest.json 的 permissions 一致（权威是包内那份）。字符串数组、不得重复、最多 8 个，取值见 permissionId；没有任何能力时省略本字段，不要写空数组。",
          "type": "array",
          "items": { "$ref": "#/$defs/permissionId" },
          "uniqueItems": true,
          "minItems": 1,
          "maxItems": 8
        },
        "sqlite": { "$ref": "#/$defs/sqliteScope" },
        "homepage": { "type": "string", "format": "uri" },
        "repository": { "type": "string", "format": "uri" },
        "platforms": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "windows-amd64": { "$ref": "#/$defs/artifact" },
            "darwin-amd64": { "$ref": "#/$defs/artifact" },
            "darwin-arm64": { "$ref": "#/$defs/artifact" },
            "linux-amd64": { "$ref": "#/$defs/artifact" },
            "linux-arm64": { "$ref": "#/$defs/artifact" }
          }
        }
      }
    }
  }
}
